# Copy to config/.env and fill in. Never commit the real file.

# Main (real) account - used only when execution.testnet = false
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Futures testnet (https://testnet.binancefuture.com) - used when execution.testnet = true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Telegram notifications (optional): token from @BotFather; chat id is filled by
# scripts/telegram_setup.py after you press Start in your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
